def parse_action(spec):
    kind, _, arg = spec.partition(":")
    kind, arg = kind.strip().lower(), arg.strip()
    if kind == "key":
        codes = []
        for part in arg.lower().split("+"):
            part = part.strip()
            code = getattr(e, "KEY_" + KEY_ALIASES.get(part, part.upper()), None)
            if not isinstance(code, int):
                raise ValueError("phím không hợp lệ: '%s'" % part)
            codes.append(code)
        return ("key", codes)
    if kind == "mouse":
        if arg.lower() not in MOUSE_NAMES:
            raise ValueError("nút chuột không hợp lệ: '%s'" % arg)
        return ("mouse", MOUSE_NAMES[arg.lower()])
    if kind == "scroll":
        if arg.lower() not in SCROLL_DIRS:
            raise ValueError("hướng cuộn không hợp lệ: '%s'" % arg)
        return ("scroll", SCROLL_DIRS[arg.lower()])
    if kind == "cmd":
        if not arg:
            raise ValueError("thiếu lệnh sau 'cmd:'")
        return ("cmd", arg)
    if kind == "kb":
        if arg.lower() not in ("toggle", "snap"):
            raise ValueError("kb chỉ nhận 'toggle' hoặc 'snap'")
        return ("kb", arg.lower())
    raise ValueError("hành động không hợp lệ: '%s'" % spec)


