def curve(v):
    """Vùng chết đã được normf() cắt; ở đây co giãn lại và áp đường cong bậc 2:
    đẩy nhẹ thì chậm và chính xác, đẩy hết cỡ thì nhanh."""
    if v == 0:
        return 0.0
    a = (abs(v) - MOVE_DEADZONE) / (1.0 - MOVE_DEADZONE)
    a = a * a
    return a if v > 0 else -a


