class Key:
    def __init__(self, label, code, width=4, shifted=None, mod=False):
        self.label = label
        self.shifted = shifted or label
        self.code = code
        self.width = width
        self.mod = mod
        self.x = 0
        self.button = None

    @property
    def center(self):
        return self.x + self.width / 2


def K(label, name, width=4, shifted=None, mod=False):
    return Key(label, getattr(e, "KEY_" + name), width, shifted, mod)


def build_rows():
    r0 = [K("Esc", "ESC")]
    for ch, sh in zip("1234567890", "!@#$%^&*()"):
        r0.append(K(ch, ch, 4, sh))
    r0 += [K("-", "MINUS", 4, "_"), K("=", "EQUAL", 4, "+"), K("⌫", "BACKSPACE", 8)]

    r1 = [K("Tab", "TAB", 6)]
    r1 += [K(c, c.upper(), 4, c.upper()) for c in "qwertyuiop"]
    r1 += [K("[", "LEFTBRACE", 4, "{"), K("]", "RIGHTBRACE", 4, "}"),
           K("\\", "BACKSLASH", 6, "|")]

    r2 = [K("Caps", "CAPSLOCK", 7)]
    r2 += [K(c, c.upper(), 4, c.upper()) for c in "asdfghjkl"]
    r2 += [K(";", "SEMICOLON", 4, ":"), K("'", "APOSTROPHE", 4, '"'),
           K("⏎", "ENTER", 9)]

    r3 = [K("Shift", "LEFTSHIFT", 9, mod=True)]
    r3 += [K(c, c.upper(), 4, c.upper()) for c in "zxcvbnm"]
    r3 += [K(",", "COMMA", 4, "<"), K(".", "DOT", 4, ">"), K("/", "SLASH", 4, "?"),
           K("▲", "UP", 6), K("Del", "DELETE", 5)]

    r4 = [K("Ctrl", "LEFTCTRL", 6, mod=True), K("Super", "LEFTMETA", 6, mod=True),
          K("Alt", "LEFTALT", 6, mod=True), K("Space", "SPACE", 24),
          K("◀", "LEFT", 6), K("▼", "DOWN", 6), K("▶", "RIGHT", 6)]

    rows = [r0, r1, r2, r3, r4]
    for row in rows:
        x = 0
        for k in row:
            k.x = x
            x += k.width
    return rows


ROWS = build_rows()
