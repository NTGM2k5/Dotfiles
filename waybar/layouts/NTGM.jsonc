{
    "layer": "top",
    "output": ["HDMI-A-1"],
    "height": 30,
    "exclusive": true,
    "passthrough": false,
    "reload_style_on_change": true,

    "modules-left": ["ext/workspaces" , "custom/cava"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "tray"],

    "custom/cava": {
    "exec": "$HOME/.config/waybar/cava.sh",
    "format": "{}",
    "tooltip": false
},

    "ext/workspaces": {
    "format": "{icon}",
    "format-icons": {
        "default": "○",
        "active": "●"
    },
    "sort-by-id": true,
    "on-scroll-up": "mmsg dispatch viewtoleft",
    "on-scroll-down": "mmsg dispatch viewtoright"  
},

    "clock": {
        "format": "{:%H:%M}",
        "tooltip": false,
        "on-click": "pkill gsimplecal || XDG_CONFIG_HOME=$HOME/.config/gsimplecal-env gsimplecal"
    },

    "pulseaudio": {
        "format": "{volume}%",
        "format-muted": "muted",
        "on-click": "pavucontrol"
    },

    "tray": {
        "spacing": 10
    }
}
